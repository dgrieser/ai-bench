{
  "title": "LLM Benchmarks",
  "benchmarks": {
    "aa_intelligence_index": {
      "name": "AA Intelligence Index",
      "short_name": "Index",
      "category": "Composite Index",
      "description": "Artificial Analysis composite index combining multiple evaluations (including τ²-Bench Telecom, Terminal-Bench Hard, GPQA Diamond, and HLE) to synthesize overall model capability.",
      "icon_svg": "icons/artificial-analysis.svg",
      "urls": [
        "https://artificialanalysis.ai/methodology/intelligence-benchmarking"
      ]
    },
    "aa_coding_index": {
      "name": "AA Coding Index",
      "short_name": "Coding",
      "category": "Composite Index",
      "description": "Artificial Analysis composite index for coding performance combining multiple evaluations (including Terminal-Bench Hard, and SciCodeBench) to synthesize overall model capability.",
      "icon_svg": "icons/artificial-analysis.svg",
      "urls": [
        "https://artificialanalysis.ai/methodology/intelligence-benchmarking"
      ]
    },
    "swe_bench_verified": {
      "name": "SWE-bench Verified",
      "short_name": "SWE Verified",
      "category": "Software Engineering",
      "description": "Human-validated subset of SWE-bench for fixing real GitHub issues; solutions are judged by running unit tests.",
      "urls": [
        "https://www.swebench.com/SWE-bench/"
      ]
    },
    "swe_bench_pro": {
      "name": "SWE-bench Pro",
      "short_name": "SWE Pro",
      "category": "Software Engineering",
      "description": "Successor to SWE-bench Verified for realistic software engineering tasks; spans Python, JavaScript, TypeScript, and Go, and is designed to be more contamination-resistant and industry-relevant.",
      "urls": [
        "https://huggingface.co/datasets/ScaleAI/SWE-bench_Pro",
        "https://openai.com/index/why-we-no-longer-evaluate-swe-bench-verified/"
      ]
    },
    "swe_rebench": {
      "name": "SWE-Rebench",
      "short_name": "SWE Rebench",
      "category": "Software Engineering",
      "description": "A continuously updated, decontaminated benchmark for evaluating software-engineering LLMs on real-world coding tasks under a standardized evaluation setup.",
      "urls": [
        "https://swe-rebench.com"
      ]
    },
    "mmmu_pro": {
      "name": "MMMU Pro",
      "short_name": "MMMU Pro",
      "category": "Vision-language Reasoning",
      "description": "Vision-centric extension of MMMU that rigorously evaluates large multimodal models on challenging, college-level tasks requiring expert, cross‑disciplinary understanding and integrated visual–text reasoning.",
      "icon_svg": "icons/mmmu-pro.svg",
      "urls": [
        "https://mmmu-benchmark.github.io/",
        "https://aclanthology.org/2025.acl-long.1317/",
        "https://huggingface.co/datasets/MMMU/MMMU_Pro"
      ]
    },
    "terminal_bench_hard": {
      "name": "Terminal-Bench Hard",
      "short_name": "Term Hard",
      "category": "Agentic Coding & Terminal Use",
      "description": "Hard subset of Terminal-Bench tasks; benchmark of real terminal tasks in sandboxed environments with test scripts.",
      "urls": [
        "https://www.tbench.ai/"
      ]
    },
    "terminal_bench_2_0": {
      "name": "Terminal-Bench 2.0",
      "short_name": "Term 2.0",
      "category": "Agentic Coding & Terminal Use",
      "description": "Terminal-Bench 2.0 is a collection of tasks and an evaluation harness to help agent makers quantify their agents' terminal mastery.",
      "urls": [
        "https://www.tbench.ai/leaderboard/terminal-bench/2.0"
      ]
    },
    "tau2_bench_telecom": {
      "name": "τ²-Bench Telecom",
      "short_name": "τ² Telecom",
      "category": "Agentic Tool Use",
      "description": "Dual-control conversational agent benchmark where both agent and user use tools in a shared environment; includes a compositional task generator; Telecom domain.",
      "urls": [
        "https://arxiv.org/abs/2506.07982"
      ]
    },
    "browsecomp": {
      "name": "BrowseComp",
      "short_name": "BrowseComp",
      "category": "Web Browsing",
      "description": "Browsing benchmark with 1,266 challenging short-answer questions designed to be hard to find but easy to verify.",
