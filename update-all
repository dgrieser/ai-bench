#!/bin/bash
#
# Refresh every benchmark score in llm.json.
#
#   ./update-all                        interactive: prompts for new models and
#                                       unrecognised source names as it goes
#   ./update-all --collect-prompts [F]  unattended (cron, CI): asks nothing,
#                                       queues every question in F, and records
#                                       no answers, so the questions come back
#                                       on the next interactive run
#
# Deliberately does not set -e: one dead scraper must not stop the rest. Exit
# codes are collected and reported at the end instead.
#
# Exit status: 0 when everything ran, 1 when a step failed, and 3 when the only
# failures were fetchers -- a mapping updater that could not read its board, or
# a source update.py had to skip. Those are warnings, not failures: every other
# score still landed, and the source's own columns stay where the last good run
# left them. With AI_BENCH_FETCH_WARNINGS set, each one is also recorded there
# for the workflow to annotate (see _fetch_warnings.py).

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"

COLLECT_ARGS=()
REPORT=""

usage() {
    cat <<'EOF'
usage: update-all [--collect-prompts [FILE]]

  (no flags)                 interactive: prompts for new models and
                             unrecognised source names as it goes
  --collect-prompts [FILE]   unattended (cron, CI): asks nothing, queues every
                             question in FILE (default pending-prompts.jsonl)
                             and records no answers, so the questions come back
                             on the next interactive run
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --collect-prompts)
            REPORT="${SCRIPT_DIR}/pending-prompts.jsonl"
            if [ -n "$2" ] && [ "${2#-}" = "$2" ]; then
                REPORT="$2"
                shift
            fi
            shift
            ;;
        --collect-prompts=*)
            REPORT="${1#*=}"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "unknown argument: $1" 1>&2
            usage 1>&2
            exit 2
            ;;
    esac
done

if [ -n "$REPORT" ]; then
    # Exported so nested subprocesses (check_new.py -> add.py) collect too, and
    # truncated once here so the sub-commands append to one fresh report.
    export AI_BENCH_PENDING_PROMPTS="$REPORT"
    : > "$REPORT" || exit 1
    COLLECT_ARGS=(--collect-prompts "$REPORT")
    echo "+ collect mode: queueing prompts in ${REPORT}, recording no answers" 1>&2
fi

FAILED=()
# Fetchers that failed: reported, but not a failed run. See the exit status above.
WARNINGS=()
WARNINGS_ONLY_EXIT=3

if [ -n "${AI_BENCH_FETCH_WARNINGS:-}" ]; then
    # Truncated once here, like the prompt report: update.py appends its own
    # entries, and a stale file would annotate this run with a past one's.
    : > "$AI_BENCH_FETCH_WARNINGS" || exit 1
fi

# Wall clock in milliseconds. EPOCHREALTIME is a bash 5 builtin, so a timing
# costs no process of its own; the fallback keeps whole-second timings on the
# bash 3.2 that macOS still ships as /bin/bash.
now_ms() {
    if [ -n "${EPOCHREALTIME:-}" ]; then
        # "1758312124.214147" -> microseconds. A comma is possible under a
        # locale that decimal-separates that way, so both are stripped.
        local raw="${EPOCHREALTIME/./}"
        raw="${raw/,/}"
        echo $(( 10#${raw} / 1000 ))
    else
        echo $(( $(date +%s) * 1000 ))
    fi
}

# One decimal, matching what update.py prints per fetcher, so the two halves of
# a run's log read as one scale.
fmt_ms() {
    printf '%d.%ds' $(( $1 / 1000 )) $(( ($1 % 1000) / 100 ))
}

# label<TAB>milliseconds per step, in the order they ran. Kept for the summary
# at the end rather than only printed as it goes: the per-step lines are spread
# across thousands of lines of scraper output, and the question being asked is
# always which of them to look at first.
TIMINGS=()
STARTED_MS=$(now_ms)

# A mapping updater is a scrape of one board's names, so its failure is that
# board's, not the run's. Recognised by name, as the loop below finds them.
is_fetcher() {
    case "$1" in
        update_*_mapping.py) return 0 ;;
    esac
    return 1
}

run() {
    local label="$1"
    shift
    echo "+ Running ${label}" 1>&2
    local started=$(now_ms)
    local status
    local errlog=""
    if [ -n "${AI_BENCH_FETCH_WARNINGS:-}" ] && is_fetcher "$label"; then
        # Unattended only: stderr is copied aside so the warning can say why,
        # which costs stderr its tty -- harmless in CI, not at a terminal.
        errlog=$(mktemp)
        { "$@" 2>&1 1>&3 3>&- | tee "$errlog" 1>&2 3>&-; } 3>&1
        status=${PIPESTATUS[0]}
    else
        "$@"
        status=$?
    fi
    # Timed on the way out whatever happened, so a step that failed slowly --
    # a scraper retrying against a dead host -- is in the table too, which is
    # exactly the one worth seeing.
    local elapsed=$(( $(now_ms) - started ))
    TIMINGS+=("${label}	${elapsed}")
    echo "+ ${label} took $(fmt_ms ${elapsed})" 1>&2
    if [ $status -ne 0 ] && is_fetcher "$label"; then
        WARNINGS+=("${label} (exit ${status})")
        if [ -n "$errlog" ]; then
            # The last lines are the exception, which is what names the cause.
            "${SCRIPT_DIR}/_fetch_warnings.py" record "$AI_BENCH_FETCH_WARNINGS" \
                --step "$label" --message "$(grep -v '^[[:space:]]*$' "$errlog" | tail -n 3)"
        fi
    elif [ "$label" = "update.py" ] && [ $status -eq $WARNINGS_ONLY_EXIT ]; then
        # Sources it could not read, and nothing else; it recorded each itself.
        WARNINGS+=("${label}: source(s) skipped (see above)")
    elif [ $status -ne 0 ]; then
        FAILED+=("${label} (exit ${status})")
    fi
    [ -n "$errlog" ] && rm -f "$errlog"
    return 0
}

# Longest first: the ordering the log is read in when a run got slower and
# nobody knows which step to blame. The by-hand elapsed total covers the gaps
# between steps as well -- there are none worth naming today, but a total that
# is the sum of its parts would hide one if there ever were.
report_timings() {
    local total=$(( $(now_ms) - STARTED_MS ))
    echo 1>&2
    echo "step timings (longest first):" 1>&2
    local row
    for row in "${TIMINGS[@]}"; do
        printf '%s\t%s\n' "${row#*	}" "${row%%	*}"
    done | sort -rn | while IFS=$'\t' read -r ms label; do
        printf '  %8s  %s\n' "$(fmt_ms ${ms})" "${label}" 1>&2
    done
    printf '  %8s  total\n' "$(fmt_ms ${total})" 1>&2
}

# Record the pages the scrapers below read; independent of the scores, so first
# and non-interactive either way.
run "fill_source_urls.py" "${SCRIPT_DIR}/fill_source_urls.py" -w

# Offer newly released open-weights models for addition first, so the update
# pass below fills in their scores. Interactive when run from a terminal;
# report-only otherwise.
run "check_new.py" "${SCRIPT_DIR}/check_new.py" "${COLLECT_ARGS[@]}"

for s in "${SCRIPT_DIR}"/update_*.py; do
    # SWE-Rebench is unwired from the score pipeline; its fetcher and mapping
    # updater remain standalone tools, so nothing here needs their mappings.
    case "$(basename "$s")" in
        update_rebench_mapping.py) continue ;;
    esac
    run "$(basename "$s")" "$s" -w "${COLLECT_ARGS[@]}"
done

run "update.py" "${SCRIPT_DIR}/update.py" -w

# The ranking, printed rather than recomputed. update.py refreshes every
# derived index in memory before it writes -- it has to, since a score it just
# moved re-ranks the whole field -- so by the time this runs the columns in
# llm.json are already this run's, and the recompute that used to stand here
# was a second full fit whose verdict was "up to date. Nothing to do." It cost
# 41 seconds of a 439-second refresh; the report is a file read, and prints the
# identical tables.
#
# What is lost is that the second fit would also have *repaired* the columns if
# update.py had somehow left them wrong. That is not this step's job to carry:
# update.py cannot skip its refresh on this path (only --fill-source-urls
# skips, which update-all never passes), and `./derive_indexes.py -w` remains
# the repair path for a file edited by hand. --report-only still warns if a
# model carries no index at all, which is what "nobody refreshed these" looks
# like from here.
run "derive_indexes.py" "${SCRIPT_DIR}/derive_indexes.py" --report-only

if [ -n "$REPORT" ]; then
    echo 1>&2
    "${SCRIPT_DIR}/pending_prompts.py" "$REPORT" --format text 1>&2
fi

report_timings

if [ ${#WARNINGS[@]} -gt 0 ]; then
    echo 1>&2
    echo "${#WARNINGS[@]} fetcher warning(s); their sources were skipped:" 1>&2
    for w in "${WARNINGS[@]}"; do
        echo "  - ${w}" 1>&2
    done
fi

if [ ${#FAILED[@]} -gt 0 ]; then
    echo 1>&2
    echo "${#FAILED[@]} step(s) failed:" 1>&2
    for f in "${FAILED[@]}"; do
        echo "  - ${f}" 1>&2
    done
    exit 1
fi

if [ ${#WARNINGS[@]} -gt 0 ]; then
    exit $WARNINGS_ONLY_EXIT
fi
